    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2022"
  },
  "exclude": ["node_modules", "dist"],
  "extends": "@logpose/typescript-config/base.json",
  "include": ["src"]

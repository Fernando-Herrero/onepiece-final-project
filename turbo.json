{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "dist/**"],
      "env": ["API_INTERNAL_URL"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "format": {},
    "format-check": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "@logpose/web#dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true,
      "with": ["@logpose/api#dev"]
    }
  },
  "ui": "tui"
}

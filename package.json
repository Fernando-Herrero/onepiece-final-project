{
  "name": "logpose",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "commitlint": "commitlint --edit",
    "dev": "turbo run dev",
    "format": "prettier --write README.md GLOSSARY.md docs/CONVENTIONS.md docs/adr package.json turbo.json tsconfig.json && turbo run format",
    "format-check": "prettier --check README.md GLOSSARY.md docs/CONVENTIONS.md docs/adr package.json turbo.json tsconfig.json && turbo run format-check",
    "lint": "turbo run lint",
    "prepare": "husky",
    "start": "turbo run start",
    "test": "turbo run test",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@logpose/eslint-config": "workspace:*",
    "@logpose/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-sort-json": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "engines": {
    "node": "24.16.0"
  }
}

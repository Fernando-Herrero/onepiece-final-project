PORT=4000
# Replica set: borrar una cuenta usa una transacción (en local, mongod --replSet rs0 y rs.initiate()).
MONGODB_URI=mongodb://localhost:27017/logpose
MONGODB_DBNAME=logpose

# Cloudinary — necesario para subir imágenes en posts (community)
# Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

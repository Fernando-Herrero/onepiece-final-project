    "@nestjs/testing": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }

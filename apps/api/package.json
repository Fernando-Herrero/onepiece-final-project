{
  "name": "@logpose/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,html}\"",
    "format-check": "prettier --check \"**/*.{ts,tsx,md,json,html}\"",
    "lint": "eslint . --max-warnings 0",
    "normalize-research": "node src/scripts/normalize-research.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@jperezmart/nest-mongodb": "^0.1.0",
    "@logpose/contracts": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@orpc/nest": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongodb": "^7.0.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@logpose/eslint-config": "workspace:*",
    "@logpose/typescript-config": "workspace:*",
